# Gemini API Key (Get a free key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g., gemini-3.5-flash-lite, gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Port configuration (Default is 8080)
PORT=8080

# Security Configuration
# Require clients to send this token in the 'X-API-Key' header (Leave blank to disable authentication)
API_AUTH_TOKEN=
# Allowed origins for CORS (Comma-separated list, e.g. http://localhost:3000, or * for all)
ALLOWED_ORIGINS=*
# Maximum base64 file payload size in Megabytes (Default is 15MB)
MAX_FILE_SIZE_MB=15

# Local Zero-Shot Vision Classifier Settings (CLIP)
# (Uses CLIP for images and PDFs. Set to True to enable zero-training checks)
ENABLE_LOCAL_CLASSIFIER=False
VISION_CLASSIFIER_MODEL=openai/clip-vit-base-patch32
LOCAL_CLASSIFIER_CONFIDENCE_THRESHOLD=0.30

# Local YOLOv11 Verification settings
ENABLE_YOLO_CHECK=True
YOLO_MODEL_PATH=yolo11n-cls.pt
YOLO_CONFIDENCE_THRESHOLD=0.60
